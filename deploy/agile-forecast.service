[Unit]
Description=Agile Forecast web UI and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agile
Group=agile
WorkingDirectory=/opt/agile-forecast
EnvironmentFile=/etc/agile-forecast.env
ExecStart=/opt/agile-forecast/.venv/bin/uvicorn app.main:app --host ${AGILE_HOST} --port ${AGILE_PORT} --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
